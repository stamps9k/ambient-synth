{
  "name": "ambient-synth",
  "version": "0.0.1",
  "description": "A library for generating ambient music / noise in the web browser using the Web Audio API.",
  "keywords": [
    "web-audio",
    "ambient",
    "synth",
    "library"
  ],
  "homepage": "https://github.com/stamps9k/ambient-synth#readme",
  "bugs": {
    "url": "https://github.com/stamps9k/ambient-synth/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stamps9k/ambient-synth.git"
  },
  "license": "GPL-3.0-or-later",
  "author": "James Stamp",
  "type": "module",
  "main": "./index.mjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    }
  },
  "scripts": {
    "test": "vitest",
    "build": "tsup && tsc --project tsconfig.build.json --emitDeclarationOnly --outDir dist && node -e \"const p=require('./package.json');for(const k of ['scripts','devDependencies','lint-staged','overrides'])delete p[k];require('fs').writeFileSync('dist/package.json',JSON.stringify(p,null,2)+'\\n')\"",
    "dev": "concurrently \"tsup --watch\" \"tsc --project tsconfig.build.json --emitDeclarationOnly --outDir dist --watch\"",
    "prepare": "husky",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "audit:ci": "npx --yes audit-ci@7.1.0 --config audit-ci.jsonc"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*": "prettier --write --ignore-unknown"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.5"
  }
}
